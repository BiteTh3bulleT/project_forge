{
  "name": "forge",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/shared",
    "packages/ui"
  ],
  "scripts": {
    "core": "cd services/core && go run .",
    "forge-core": "npm run core",
    "build:core": "cd services/core && go build ./...",
    "build:desktop": "npm -w @forge/desktop run build",
    "build": "npm run build:desktop && npm run build:core",
    "install": "npm install",
    "desktop": "npm -w @forge/desktop run tauri -- dev",
    "dev": "npm run desktop",
    "up": "node ./scripts/forge-up.mjs",
    "down": "node ./scripts/forge-down.mjs"
  }
}
