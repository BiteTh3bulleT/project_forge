{
  "name": "forge",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/shared",
    "packages/ui"
  ],
  "scripts": {
    "core": "node ./scripts/forge-core.mjs",
    "forge-core": "npm run core",
    "build:core": "node ./scripts/check-vsa-files.mjs --require-tracked && cd services/core && go build ./...",
    "build:desktop": "npm -w @forge/desktop run build",
    "typecheck:desktop": "npm -w @forge/desktop run typecheck",
    "test:desktop": "npm -w @forge/desktop run test",
    "validate:desktop": "npm -w @forge/desktop run validate",
    "test:rust:forgek": "cd crates/forgek-validate && cargo test",
    "validate:forgek-fixtures": "cd crates/forgek-validate && cargo run -- validate-fixtures ../../fixtures/forgek",
    "test:forgek:parity": "node ./scripts/forgek-parity.mjs",
    "validate:forgek": "npm run test:rust:forgek && npm run validate:forgek-fixtures && npm run test:forgek:parity",
    "test:core": "node ./scripts/check-vsa-files.mjs --require-tracked && cd services/core && go test ./...",
    "vet:core": "node ./scripts/check-vsa-files.mjs --require-tracked && cd services/core && go vet ./...",
    "test": "npm run test:core",
    "lint": "npm run vet:core",
    "typecheck": "npm run typecheck:desktop",
    "build": "npm run build:desktop && npm run build:core",
    "docker:config": "docker compose config",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:start": "node ./scripts/forge-docker-up.mjs",
    "docker:stop": "node ./scripts/forge-docker-down.mjs",
    "docker:desktop": "node ./scripts/forge-docker-desktop.mjs",
    "desktop:clean-port": "node ./scripts/desktop-clean-port.mjs 1420",
    "desktop:check": "node ./scripts/check-desktop-deps.mjs",
    "desktop": "npm run desktop:clean-port && npm run desktop:check && npm -w @forge/desktop run tauri -- dev",
    "dev": "npm run desktop",
    "up": "node ./scripts/forge-up.mjs",
    "down": "node ./scripts/forge-down.mjs",
    "smoke": "bash ./scripts/forge-smoke.sh"
  }
}
