# FORGE Desktop — example environment file.
#
# Copy to apps/desktop/.env.development (for `npm run desktop` /
# `tauri dev`) or apps/desktop/.env.production (for `tauri build`).
# Vite inlines VITE_* variables at build time, so a built binary cannot
# be repointed at runtime — rebuild if the core URL changes.

# URL of the FORGE core service. Must match where `go run .` (or
# `npm run core`) is listening — FORGE_CORE_PORT in the core env.
VITE_FORGE_API_URL=http://127.0.0.1:18492
