{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FORGE",
  "version": "0.1.0",
  "identifier": "dev.forge.workshop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FORGE",
        "width": 1320,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: tauri: https://tauri.localhost https://asset.localhost asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://tauri.localhost https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
