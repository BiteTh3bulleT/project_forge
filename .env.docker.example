# Copy to .env.docker or pass with:
# docker compose --env-file .env.docker up --build

FORGE_CORE_PORT=18492
FORGE_DESKTOP_PORT=1420

# Persisted SQLite and local model artifacts live in named Docker volumes.
FORGE_DATA_DIR=/data
FORGE_MODEL_HOME=/models
FORGE_WORKSPACE_DIR=/workspace

# Keep live modelruntime disabled unless intentionally testing it.
FORGE_ENABLE_MODEL_RUNTIME=false
FORGE_ENABLE_OPENAI_COMPAT_API=false

# Optional local Ollama profile:
# docker compose --profile ollama up --build
# FORGE_ENABLE_MODEL_RUNTIME=true
# FORGE_MODEL_OPENAI_COMPAT_ENDPOINT=http://ollama:11434/v1
# FORGE_MODEL_DEFAULT_BACKEND=openai_compat

# Optional TEI embedding profile:
# docker compose --profile tei up --build
# FORGE_EMBEDDING_PROVIDER=tei
# FORGE_EMBEDDING_TEI_ENDPOINT=http://tei:80
