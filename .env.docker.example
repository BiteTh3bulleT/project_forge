# Copy to .env.docker or pass with:
# docker compose --env-file .env.docker up --build

FORGE_CORE_PORT=18492
FORGE_DESKTOP_PORT=1420
FORGE_POSTGRES_PORT=5432
FORGE_REDIS_PORT=6379
FORGE_QDRANT_HTTP_PORT=6333
FORGE_QDRANT_GRPC_PORT=6334

# Persisted SQLite and local model artifacts live in named Docker volumes.
FORGE_DATA_DIR=/data
FORGE_MODEL_HOME=/models
FORGE_WORKSPACE_DIR=/workspace

# Managed service containers. These are infrastructure-ready until the
# application storage adapters are migrated behind explicit tests.
FORGE_STORE_BACKEND=sqlite
FORGE_POSTGRES_DB=forge
FORGE_POSTGRES_USER=forge
FORGE_POSTGRES_PASSWORD=forge_dev_password
FORGE_POSTGRES_DSN=postgres://forge:forge_dev_password@postgres:5432/forge?sslmode=disable
FORGE_REDIS_ADDR=redis:6379
FORGE_QDRANT_URL=http://qdrant:6333

# Shadow diagnostic persistence is opt-in and stores safe summaries only.
FORGE_SHADOW_DIAGNOSTIC_PERSISTENCE_ENABLED=false
FORGE_SHADOW_DIAGNOSTIC_RETENTION_DAYS=30
FORGE_SHADOW_DIAGNOSTIC_MAX_PAYLOAD_BYTES=65536

# Docker-backed desktop expects the model runtime surface to be available.
# The default endpoint reaches a host Ollama daemon through Docker's host gateway.
FORGE_ENABLE_MODEL_RUNTIME=true
FORGE_MODEL_OPENAI_COMPAT_ENDPOINT=
FORGE_MODEL_DEFAULT_BACKEND=
OLLAMA_BASE_URL=http://host.docker.internal:11434
FORGE_ENABLE_OPENAI_COMPAT_API=false

# Optional local Ollama profile:
# docker compose --profile ollama up --build
# FORGE_ENABLE_MODEL_RUNTIME=true
# FORGE_MODEL_OPENAI_COMPAT_ENDPOINT=http://ollama:11434
# FORGE_MODEL_DEFAULT_BACKEND=openai_compat

# Optional TEI embedding profile:
# docker compose --profile tei up --build
# FORGE_EMBEDDING_PROVIDER=tei
# FORGE_EMBEDDING_TEI_ENDPOINT=http://tei:80
